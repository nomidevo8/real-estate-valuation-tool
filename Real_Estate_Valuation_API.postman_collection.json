{
	"info": {
		"_postman_id": "real-estate-valuation-api",
		"name": "Real Estate Valuation API",
		"description": "Complete API collection for Real Estate Valuation Plugin with test data",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Upload Data",
			"item": [
				{
					"name": "Upload CSV File",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "IMMO.csv"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/wp-json/reval/v1/upload",
							"host": ["{{base_url}}"],
							"path": ["wp-json", "reval", "v1", "upload"]
						}
					},
					"response": []
				},
				{
					"name": "Upload XLSX File",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "valuation_data.xlsx"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/wp-json/reval/v1/upload",
							"host": ["{{base_url}}"],
							"path": ["wp-json", "reval", "v1", "upload"]
						}
					},
					"response": []
				}
			]
		},
