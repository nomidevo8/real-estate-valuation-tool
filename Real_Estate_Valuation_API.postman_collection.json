		{
			"name": "Evaluation Management",
			"item": [
				{
					"name": "Get All Evaluations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/wp-json/reval/v1/evaluations?limit=20&offset=0",
							"host": ["{{base_url}}"],
							"path": ["wp-json", "reval", "v1", "evaluations"],
							"query": [
								{
									"key": "limit",
									"value": "20"
								},
								{
									"key": "offset",
									"value": "0"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Evaluation by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/wp-json/reval/v1/evaluations/{{evaluation_id}}",
							"host": ["{{base_url}}"],
							"path": ["wp-json", "reval", "v1", "evaluations", "{{evaluation_id}}"]
						}
					},
					"response": []
				},
				{
					"name": "Get Evaluations with Pagination",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{admin_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/wp-json/reval/v1/evaluations?limit=10&offset=20",
							"host": ["{{base_url}}"],
							"path": ["wp-json", "reval", "v1", "evaluations"],
							"query": [
								{
									"key": "limit",
									"value": "10"
								},
								{
									"key": "offset",
									"value": "20"
								}
							]
						}
					},
					"response": []
				}
			]
